{
"compilerOptions":
	{
	"target": "esnext",
	"module": "esnext",
	"rootDir": "./src",
	"outDir": "./scripts",
	"allowSyntheticDefaultImports": true,
	"lib": ["DOM", "ESNext"],
	"forceConsistentCasingInFileNames": true,
	"strict": true,
	"skipLibCheck": true,
	"strictPropertyInitialization": true
	}
}